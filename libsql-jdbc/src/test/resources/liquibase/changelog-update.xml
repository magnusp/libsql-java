<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="update-1" author="liquibase-it">
        <createTable tableName="lb_person">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="lb_person" indexName="lb_person_name_idx">
            <column name="name"/>
        </createIndex>
        <insert tableName="lb_person">
            <column name="name" value="Ada"/>
            <column name="active" valueBoolean="true"/>
            <column name="created_at" valueDate="2024-01-02T03:04:05"/>
        </insert>
    </changeSet>

    <changeSet id="update-2" author="liquibase-it">
        <addColumn tableName="lb_person">
            <column name="email" type="VARCHAR(255)"/>
        </addColumn>
        <sql>UPDATE lb_person SET email = 'ada@example.com' WHERE name = 'Ada'</sql>
    </changeSet>
</databaseChangeLog>

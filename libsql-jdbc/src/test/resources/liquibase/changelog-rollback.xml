<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="rollback-1" author="liquibase-it">
        <createTable tableName="lb_rb_widget">
            <column name="id" type="INTEGER">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="label" type="VARCHAR(50)"/>
        </createTable>
        <rollback>
            <dropTable tableName="lb_rb_widget"/>
        </rollback>
    </changeSet>

    <changeSet id="rollback-2" author="liquibase-it">
        <createIndex tableName="lb_rb_widget" indexName="idx_lb_rb_label">
            <column name="label"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="lb_rb_widget" indexName="idx_lb_rb_label"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
